# Copy to `.env` and fill in. Everything here is OPTIONAL — the stack runs offline
# with sensible fallbacks (local echo model, hashed embeddings, no sandbox). These
# make it *better*, not *required*. See README → "What still needs real creds".

# ── Model access ────────────────────────────────────────────────────────────
# One OpenRouter key unlocks every model (cost is read back per call, so the
# spend rail stays honest). Set this OR a per-provider key below.
OPENROUTER_API_KEY=

# Per-provider metered keys (used if OpenRouter is not set).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Security ────────────────────────────────────────────────────────────────
# Seals API keys at rest with envelope encryption. Generate one with:
#   python -m lineage.security.vault --keygen
# Leave blank to store keys in plaintext (fine for local dev).
LINEAGE_SECRET_KEY=

# ── Local models (optional, free) ───────────────────────────────────────────
# Point at a running Ollama to route cheap work there. `docker compose --profile
# local up` starts one; otherwise set this to your own host's Ollama.
OLLAMA_URL=

# ── Embeddings (optional) ───────────────────────────────────────────────────
# A text-embeddings-inference server (e.g. BGE-M3) for real semantic retrieval.
# Unset = the deterministic local hashed embedder (weak but GPU-free).
EMBED_URL=

# ── Sandbox isolation (optional) ────────────────────────────────────────────
# Set SANDBOX_DOCKER=1 to run produced code in read-only, network-none
# containers. SANDBOX_RUNTIME=runsc adds gVisor when it's installed.
SANDBOX_DOCKER=
SANDBOX_RUNTIME=
